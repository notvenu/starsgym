{
  "name": "stargym",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/check.mjs",
    "demo": "node --env-file=.env.local supabase/demo.mjs",
    "demo:remove": "node --env-file=.env.local supabase/demo.mjs --remove",
    "check:staff": "node supabase/check-staff.mjs",
    "check:insights": "node supabase/check-insights.mjs",
    "check:redirects": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/check-redirects.mjs",
    "check:scan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/check-scan.mjs",
    "check:requests": "node supabase/check-requests.mjs",
    "passwords": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/set-passwords.mjs",
    "check:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/check-auth.mjs",
    "check:desk": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/check-desk.mjs",
    "check:workouts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/workouts.check.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "jsqr": "1.4.0",
    "lenis": "^1.3.27",
    "next": "^16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
