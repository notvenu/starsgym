# Copy to .env.local and fill in.

# ── Required ─────────────────────────────────────────────
# Supabase → Project Settings → API Keys (legacy anon / service_role keys work too)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Optional — the site works without these ──────────────
# Public site URL for email links (defaults to the request's origin)
NEXT_PUBLIC_SITE_URL=

# Razorpay (online payment). Without keys, checkout only offers "Pay at the desk".
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → https://YOUR-SITE/api/razorpay/webhook, event payment.captured
RAZORPAY_WEBHOOK_SECRET=

# UPI ID for the desk QR, e.g. starsgym@okaxis. Without it, the pay page shows just the reference.
NEXT_PUBLIC_UPI_ID=

# Google Places API (New) key for the reviews section. Without it, the section shows a note.
GOOGLE_PLACES_API_KEY=

# Resend (resend.com) for emailing holiday notices. Without it, notices show on the site + dashboard only.
RESEND_API_KEY=
EMAIL_FROM=Stars Gym <hello@yourdomain.com>

# Development only: sample reviews when Google isn't connected. Never set in production.
DEMO_REVIEWS=
